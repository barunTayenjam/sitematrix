#!/bin/bash
# Test stub for docker-compose/podman-compose. State comes from $STUB_DIR:
#   compose-ps.txt        service/container names returned by `ps --format {{.Names}}`
#   compose-logs-<svc>    log text returned by `logs --tail=N <svc>`
#   compose-logs-all      log text returned by `logs --tail=N`
#   compose-run.txt       every `run` invocation, one arg per line
#   run-output.txt        stdout echoed by `run` (simulates the tool's output)
#   run-exit              exit code for `run` (defaults to 0)
set -uo pipefail
: "${STUB_DIR:?STUB_DIR must be set}"
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/stub-common.sh"

# Global options (--profile <name>, -f/--file <path>) precede the subcommand,
# e.g. `--profile tools run --rm phpcs`. Skip them so `cmd` is the subcommand.
while [[ $# -gt 0 ]]; do
    case "$1" in
        --profile|-f|--file) shift; [[ $# -gt 0 ]] && shift ;;
        --profile=*|--file=*) shift ;;
        *) break ;;
    esac
done

cmd="${1:-}"
shift || true
case "$cmd" in
    ps)
        if [[ "${1:-}" == "--format" ]]; then
            # skip the format arg
            cat "$STUB_DIR/compose-ps.txt" 2>/dev/null
        else
            echo "NAME  STATUS  PORTS"
            sed 's/$/  Up  80/' "$STUB_DIR/compose-ps.txt" 2>/dev/null
        fi
        exit 0
        ;;
    logs)
        svcs=()
        last=""
        for a in "$@"; do
            case "$last" in --tail) last=""; continue ;; esac
            case "$a" in
                --tail=*) ;;
                --tail) last="$a" ;;
                *) svcs+=("$a") ;;
            esac
        done
        if [[ ${#svcs[@]} -gt 0 ]]; then
            cat "$STUB_DIR/compose-logs-${svcs[0]}.txt" 2>/dev/null
        else
            cat "$STUB_DIR/compose-logs-all.txt" 2>/dev/null
        fi
        exit 0
        ;;
    config)
        exit 0
        ;;
    restart)
        stub_record_args "$STUB_DIR/restarted.txt" "$@"
        exit 0
        ;;
    run)
        # Record the full argv so suites can assert what the tool was invoked
        # with, then optionally replay canned tool output / exit code.
        printf '%s\n' "$@" >> "$STUB_DIR/compose-run.txt"
        echo "---" >> "$STUB_DIR/compose-run.txt"
        cat "$STUB_DIR/run-output.txt" 2>/dev/null
        if [[ -f "$STUB_DIR/run-exit" ]]; then
            exit "$(cat "$STUB_DIR/run-exit")"
        fi
        exit 0
        ;;
    *)
        # up, stop, rm, exec, build, ... succeed as no-ops
        exit 0
        ;;
esac
