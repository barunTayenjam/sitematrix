# Simplified WordPress Environment Configuration

# Domain Configuration
DOMAIN_SUFFIX=127.0.0.1.nip.io

# Database Configuration
MYSQL_USER=wp_user
# Database passwords are set in git-ignored .env — do not commit credentials here.

# Redis Configuration
REDIS_PASSWORD=changeme_redis

# WordPress Configuration
WP_DEBUG=true
WP_DEBUG_DISPLAY=true
WP_DEBUG_LOG=true

# SSL Configuration
SSL_EMAIL=admin@localhost

# Cache Configuration
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# salesadmin external SQL Server (standalone app, not WordPress DB)
# Set real values in .env (git-ignored). Do not commit credentials.
ALTRYX_SQLSERVER_HOST=your-sql-server-host
ALTRYX_SQLSERVER_DB=your-database
ALTRYX_SQLSERVER_USER=your-username
ALTRYX_SQLSERVER_PASSWORD=your-password

# salesadmin external Marketo API
ALTRYX_MARKETO_HOST=https://your-instance.mktorest.com
ALTRYX_MARKETO_CLIENT_ID=your-client-id
ALTRYX_MARKETO_CLIENT_SECRET=your-client-secret